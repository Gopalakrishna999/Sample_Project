## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/
bin/
obj/

# Rider
.idea/

# VS Code
.vscode/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Files generated by the test runner
TestResult.xml
TestResults/

# Nunit
*.VisualState.xml
TestResult.xml

# Build logs
*.log

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.*

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# Publish output
publish/
*.publishsettings

# IIS Express
iisexpress/

# Azure
*.azurePubxml

# Resharper
_ReSharper*/
*.DotSettings.user

# StyleCop
StyleCopReport.xml

# Backup & temp files
*.bak
*.tmp
*.temp

# Coverage
coverage/
*.coverage
*.coveragexml

# SQL Server files
*.mdf
*.ldf

# Local DB
*.dbmdl

# Entity Framework
Migrations/

# Logs
logs/
*.log

# Windows image file caches
ehthumbs.db

# Visual Studio Code settings
.history/

# npm (if frontend inside project)
node_modules/

# Yarn
yarn-error.log

# Mac files
*.swp